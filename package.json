{
  "name": "@avraapi/node-sdk",
  "version": "1.2.0",
  "description": "Official TypeScript/JavaScript SDK for the APIX (AvraAPI) enterprise API gateway. Zero framework dependencies — works in any Node.js 18+ project.",
  "author": "Fidex Developers (Pvt) Ltd <dev@fidex.lk> (https://avraapi.com)",
  "license": "MIT",
  "keywords": [
    "apix",
    "avraapi",
    "sms",
    "pdf",
    "qr",
    "barcode",
    "sdk",
    "api-gateway"
  ],
  "homepage": "https://avraapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avraapi/apix-node-sdk.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "build:types": "tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "lint": "tsc --noEmit",
    "test": "npm run build && npm run test:runtime && npm run test:types && npm run test:package",
    "test:runtime": "node --test test/package-exports.test.mjs test/core-parity.test.mjs test/payment-core.test.mjs",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:package": "node scripts/verify-packed-consumer.cjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "@types/node": "^20.12.7"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
